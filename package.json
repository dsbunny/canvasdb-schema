{
	"name": "@dsbunny/canvasdb-schema",
	"version": "7.0.16",
	"description": "Schema for CanvasDB API and Canvas definitions with their capabilities",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"author": "Steve-o <fnjordy@gmail.com>",
	"license": "MIT",
	"private": false,
	"allowScripts": {
		"@dsbunny/capdb-schema": true,
		"@dsbunny/error-schema": true,
		"@dsbunny/webhook-schema": true
	},
	"scripts": {
		"build": "tsc",
		"clean": "rm -rf dist node_modules package-lock.json",
		"pull:upstream": "./scripts/pull-upstream.sh",
		"rebuild": "npm run clean && npm run pull:upstream && npm install && npm run build",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"devDependencies": {
		"@dsbunny/capdb-schema": "github:dsbunny/capdb-schema#169a15a",
		"@dsbunny/error-schema": "github:dsbunny/error-schema#86d038b",
		"@dsbunny/webhook-schema": "github:dsbunny/webhook-schema#de1d05d",
		"typescript": "^5.9.3",
		"zod": "^4.3.6"
	},
	"peerDependencies": {
		"@dsbunny/capdb-schema": "github:dsbunny/capdb-schema",
		"@dsbunny/error-schema": "github:dsbunny/error-schema",
		"@dsbunny/webhook-schema": "github:dsbunny/webhook-schema",
		"zod": "^4.3.0"
	}
}
